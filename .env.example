# RemindFlow AI Environment Configuration Example
# Copy this file to .env and configure your values.
# NEVER commit your real secrets to version control.

# 1. Database Connection
# Local SQLite default ($0/month local): "file:./dev.db"
# Cloud Free PostgreSQL ($0/month Neon.tech or Supabase Free Tier): "postgresql://user:pass@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="file:./dev.db"

# 2. Base Application URL (Update to your public HTTPS domain in production, e.g. https://remindflow-ai.vercel.app)
APP_URL="http://localhost:3000"
NODE_ENV="development"

# 3. Workspace Security & Background Scheduler (Recommended for Public Deployments)
# Leave WORKSPACE_ACCESS_PASSCODE empty for frictionless local use, or set a strong passcode
# in production so private contacts and campaigns require sign-in at /login.
WORKSPACE_ACCESS_PASSCODE=""
CRON_SECRET="your-random-cron-secret-placeholder"

# 4. AI Provider Configurations (Optional - Built-in rule NLP engine is used if not configured)
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"

# 5. Official Meta WhatsApp Business Cloud API (Optional - Safe Simulation Mode used if not configured)
WHATSAPP_API_TOKEN="your_meta_system_user_access_token_here"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id_here"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_business_account_id_here"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_secret_verification_token"

# 6. Public App Metadata
NEXT_PUBLIC_APP_NAME="RemindFlow AI"
